/* cuenta.css — interfaz estilo Apple/Moderno centrada y optimizada */

:host {
  display: block;
  width: 100%;
}

@keyframes slideUpFromBottom {
  from {
    opacity: 0;
    transform: translateY(100vh);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* --- CONTENEDOR DE CENTRADO --- */
/* Centramos todo el contenido de la página para que no se vea vacío a la derecha */
.page-header,
.cuenta-wrapper {
  max-width: 1000px; /* Ancho máximo para que no se estire demasiado */
  margin-left: auto;
  margin-right: auto;
