// dashboard.ts
import {
  afterNextRender,
  Component,
  computed,
  inject,
  signal,
  PLATFORM_ID,
  OnDestroy,
  effect,
  viewChild,
  ElementRef,
} from '@angular/core';
import { NavigationEnd, Router, RouterLink, RouterLinkActive, RouterOutlet } from '@angular/router';
import { CommonModule, isPlatformBrowser } from '@angular/common';
import { Subscription } from 'rxjs';

import { AuthService }              from '../services/auth.service';
import { CuentaService }            from '../cuenta/cuenta.service';
import { InicioService }            from './inicio/inicio.service';
import { HistorialService }         from '../historial/historial.service';
import { GestosService }            from '../gestos/gestos.service';
import { DispositivosService }      from '../dispositivos/dispositivos.service';
import { AlertNotificationService } from '../services/alert-notification.service';
import { WeatherService }           from './weather.service';
import { AudioService } from '../services/audio.service';
import { LucideDynamicIcon } from '@lucide/angular';
import { getActivityIcon, getGestureIcon, getDeviceIcon } from '../shared/icon-map';
import { UnifiedNotification } from './dashboard.types';

// Mapa de rutas → títulos, evita la cadena de if/else
const ROUTE_TITLES: Record<string, string> = {
  '/dashboard/inicio':     'Dashboard',
  '/dashboard/dispositivos': 'Dispositivos',
  '/dashboard/casas': 'Casas y Habitaciones',
  '/dashboard/gestos':     'Gestos',
  '/dashboard/historial':  'Historial de actividad',
  '/dashboard/control':    'Control',
  '/dashboard/ajustes':    'Ajustes',
  '/dashboard/cuenta':     'Cuenta',
};

@Component({
  selector: 'app-dashboard',
  standalone: true,
  imports: [
    RouterLink, RouterLinkActive, RouterOutlet, CommonModule,
    LucideDynamicIcon,
  ],
  templateUrl: './dashboard.html',
  styleUrl: './dashboard.css',
})
export class Dashboard implements OnDestroy {

  // ── DI ────────────────────────────────────────────────────────────────────
  private platformId           = inject(PLATFORM_ID);
  private isBrowser            = isPlatformBrowser(this.platformId);
  private router               = inject(Router);
  private historialService     = inject(HistorialService);
  private alertService         = inject(AlertNotificationService);
  private audioService         = inject(AudioService);
  public authService           = inject(AuthService);
  public cuentaService         = inject(CuentaService);
  public inicioService         = inject(InicioService);
  public gestosService         = inject(GestosService);
  public dispositivosService   = inject(DispositivosService);
  public weatherService        = inject(WeatherService);

  // ── Estado UI ─────────────────────────────────────────────────────────────
  readonly currentTitle        = signal<string>('Dashboard');
  readonly indicatorTop        = signal<number>(0);
  readonly isFirstItemActive   = signal<boolean>(false);
  readonly panelOpen           = signal(false);
  readonly menuOpen            = signal(false);
  readonly datePanelOpen       = signal(false);
  readonly sidebarCollapsed    = signal(true);

  // ── Reloj ─────────────────────────────────────────────────────────────────
  dayLabel  = '';
  timeLabel = '';

  readonly clockTime = computed(() =>
    (this.timeLabel || '--:--').replace(/\s?(AM|PM)$/i, ''),
  );
  readonly clockMeridiem = computed(() =>
    (this.timeLabel || '').match(/(AM|PM)$/i)?.[1]?.toUpperCase() ?? '',
  );

  // ── Notificaciones ────────────────────────────────────────────────────────

  readonly dismissedIds        = signal<number[]>([])
  readonly panelLoading        = this.historialService.loading;
  readonly panelError        = this.historialService.error;

  private prevNotifCount       = signal<number>(0)

  readonly recentActivities = computed <UnifiedNotification[]>(()=>{
      const alerts     = this.mapAlerts();
      const activities = this.mapActivities();
      return [...alerts, ...activities].slice(0,10)
  })

  readonly notifCount = computed(() => this.recentActivities().length);

  // ── Helpers públicos de íconos ────────────────────────────────────────────
  readonly getGestureIcon = getGestureIcon;
  readonly getDeviceIcon  = getDeviceIcon;

  readonly userName = computed(() => this.cuentaService.userName() || 'Usuario');

  // ── Estado del Visor Multimedia ──────────────────────────────────────────
  readonly mediaViewerOpen = signal(false);
  readonly currentMediaIndex = signal(0);
  readonly isPlaying = signal(false);
  readonly isMuted = signal(false);
  readonly currentTime = signal(0);
  readonly duration = signal(0);

  readonly consolidatedMedia = computed(() => {
    const gesto = this.gestosService.selectedGesto();
    if (!gesto || !gesto.detalle?.medios_referencia) return [];

    // Agrupamos para mantener el orden visual: fotos primero, luego videos
    const fotos = gesto.detalle.medios_referencia.filter((m: any) => m.tipo_media === 1);
    const videos = gesto.detalle.medios_referencia.filter((m: any) => m.tipo_media === 2);

    return [...fotos, ...videos];
  });

  readonly currentMedia = computed(() => {
    const media = this.consolidatedMedia();
    if (media.length === 0) return null;
    return media[this.currentMediaIndex()];
  });

  readonly totalMedia = computed(() => {
    return this.consolidatedMedia().length;
  });

  openMediaViewer(index: number): void {
    this.currentMediaIndex.set(index);
    this.mediaViewerOpen.set(true);
    this.isPlaying.set(true);
  }

  closeMediaViewer(): void {
    this.mediaViewerOpen.set(false);
    this.isPlaying.set(false);
  }

  nextMedia(): void {
    const next = (this.currentMediaIndex() + 1) % this.totalMedia();
    this.currentMediaIndex.set(next);
  }

  prevMedia(): void {
    const prev = (this.currentMediaIndex() - 1 + this.totalMedia()) % this.totalMedia();
    this.currentMediaIndex.set(prev);
  }

  togglePlay(): void { this.isPlaying.update(v => !v); }
  toggleMute(): void { this.isMuted.update(v => !v); }

  formatVideoTime(seconds: number): string {
    const m = Math.floor(seconds / 60);
    const s = Math.floor(seconds % 60);
    return `${m}:${s.toString().padStart(2, '0')}`;
  }

  onVideoMetadata(event: any): void {
    this.duration.set(event.target.duration);
  }

  onVideoTimeUpdate(event: any): void {
    this.currentTime.set(event.target.currentTime);
  }

  seekVideo(event: any): void {
    const video = document.querySelector('.main-media-video') as HTMLVideoElement;
    if (video) {
      const pos = (event.target.value / 100) * this.duration();
      video.currentTime = pos;
    }
  }

  skip(seconds: number): void {
    const video = document.querySelector('.main-media-video') as HTMLVideoElement;
    if (video) video.currentTime += seconds;
  }

  // ── Internos ──────────────────────────────────────────────────────────────
  private timerId?: any;
  private routerSub?: Subscription;

  verDetalleGesto(gesto: any): void {
    this.gestosService.selectedGesto.set(gesto);
    this.gestosService.getGestoDetalle(gesto.sk_gesto_id).subscribe({
      next: (detalle) => {
        this.gestosService.selectedGesto.update(current => {
          if (current && current.sk_gesto_id === gesto.sk_gesto_id) {
            return { ...current, detalle };
          }
          return current;
        });
      },
      error: () => console.error('No se pudo cargar el detalle del gesto')
    });
  }

  // Referencia al reproductor de video
  videoPlayer = viewChild<ElementRef<HTMLVideoElement>>('videoPlayer');

  constructor() {
    this.updateClock();
    if (this.isBrowser) {
      this.timerId = setInterval(() => this.updateClock(), 1000);
    }

    this.syncWithUrl(this.router.url);
    this.initRouterListener();

    afterNextRender(() => this.onBrowserReady());

    effect(() => {
      const current = this.notifCount();
      const prev    = this.prevNotifCount();
      if (current > prev){
        const newest = this.recentActivities()[0];
        if (newest?.severity === 'error'){
          this.audioService.play('alert')
        }else{
          this.audioService.play('notificacion')
        }
      }
      this.prevNotifCount.set(current)
    })

    // Efecto para controlar la reproducción del video
    effect(() => {
      const player = this.videoPlayer()?.nativeElement;
      const playing = this.isPlaying();

      if (!player) return;

      if (playing) {
        player.play().catch(err => console.warn('Autoplay bloqueado:', err));
      } else {
        player.pause();
      }
    });

    // Resetear tiempo al cambiar de media
    effect(() => {
      this.currentMediaIndex();
      this.currentTime.set(0);
      this.duration.set(0);
      this.isPlaying.set(true);
    });
  }

  ngOnDestroy(): void {
    clearInterval(this.timerId);
    this.routerSub?.unsubscribe();
  }

  // ── Acciones públicas ─────────────────────────────────────────────────────

  onLogout(): void { this.authService.confirmLogout(); }

  togglePanel(): void {
    if (!this.panelOpen()) this.datePanelOpen.set(false);
    this.panelOpen.update(v => !v);
  }

  toggleDatePanel(): void {
    if (!this.datePanelOpen()) {
      this.panelOpen.set(false);
      this.weatherService.load(this.timeLabel);
    }
    this.datePanelOpen.update(v => !v);
  }

  toggleSidebar(): void { this.sidebarCollapsed.update(v => !v); }
  toggleMenu():    void { this.menuOpen.update(v => !v); }
  closePanel():    void { this.panelOpen.set(false); }
  closeDatePanel():void { this.datePanelOpen.set(false); }
  closeMenu():     void { this.menuOpen.set(false); }

  dismissNotification(item: UnifiedNotification): void {
    if (item.type === 'alert') {
      this.alertService.dismiss(item.originalId);
    } else {
      this.dismissedIds.update(ids => {
        const next = [...ids, item.originalId];
        if (this.isBrowser) {
          try {
            localStorage.setItem('dismissed_notifications', JSON.stringify(next));
          } catch (e) {
            console.error('Error saving to localStorage:', e);
          }
        }
        return next;
      });
    }
  }

  obtenerNombreDispositivo(id: number | null): string {
    return (
      this.dispositivosService.devices().find(d => d.sk_aparato_id === id)
        ?.nombre_aparato ?? 'Sin Dispositivo'
    );
  }

  updateIndicator(): void {
    if (!this.isBrowser) return;
    setTimeout(() => {
      const active = document.querySelector('.sidebar .nav-item.active') as HTMLElement;
      if (active) this.indicatorTop.set(active.offsetTop);
    }, 50);
  }

  // ── Privados ──────────────────────────────────────────────────────────────

  private onBrowserReady(): void {
    this.updateIndicator();

    const storedName = localStorage.getItem('nombre');
    if (storedName) this.cuentaService.userName.set(storedName);

    const token = localStorage.getItem('token') ?? '';
    if (token) this.historialService.loadHistorial();

    this.loadDismissedIds();
  }

  private loadDismissedIds(): void {
    try {
      const raw = localStorage.getItem('dismissed_notifications');
      if (raw) this.dismissedIds.set(JSON.parse(raw));
    } catch {
      console.error('Error al leer notificaciones descartadas');
    }
  }

  private initRouterListener(): void {
    this.routerSub = this.router.events.subscribe(event => {
      if (!(event instanceof NavigationEnd)) return;
      const url = event.urlAfterRedirects ?? event.url;
      this.syncWithUrl(url);
      this.updateIndicator();
    });
  }

  private syncWithUrl(url: string): void {
    const match = Object.keys(ROUTE_TITLES).find(k => url.includes(k));
    this.currentTitle.set(match ? ROUTE_TITLES[match] : 'Dashboard');
    this.isFirstItemActive.set(url.includes('/dashboard/inicio') || url === '/dashboard');
  }

  private updateClock(): void {
    const now = new Date();

    const label = now.toLocaleDateString('es-ES', {
      weekday: 'long', day: 'numeric', month: 'long',
    });
    this.dayLabel  = label.charAt(0).toUpperCase() + label.slice(1);

    this.timeLabel = now
      .toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', hour12: true })
      .replace(/\./g, '')
      .toUpperCase();
  }

  private mapAlerts(): UnifiedNotification[] {
    return this.alertService.alerts()
      .filter(a => !a.dismissed)
      .map(a => ({
        id:         `alert-${a.id}`,
        type:       'alert' as const,
        severity:   a.type,
        title:      a.message,
        subtitle:   'Sistema',
        timeLabel:  this.formatTime(a.timestamp),
        icon:       getActivityIcon(a.icon),
        originalId: a.id,
      }));
  }

  private mapActivities(): UnifiedNotification[] {
    const all       = this.historialService.actividades();
    const dismissed = this.dismissedIds();

    if (!Array.isArray(all)) return [];

    return all
      .filter(a => !dismissed.includes(a.id))
      .map(a => ({
        id:         `act-${a.id}`,
        type:       'activity' as const,
        severity:   a.estado === 'Error' ? ('error' as const) : ('default' as const),
        title:      a.accion,
        subtitle:   a.dispositivo,
        timeLabel:  a.hora,
        icon:       getActivityIcon(a.icono, a.estado, a.accion),
        statusText: a.estado,
        originalId: a.id,
      }));
  }

  private formatTime(date: Date): string {
    return date
      .toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', hour12: true })
      .replace(/\./g, '')
      .toUpperCase();
  }

  /** Detecta si el dispositivo seleccionado es un MultiSocket */
  isMultisocket(tipo?: string): boolean {
    if (!tipo) return false;
    const t = tipo.toLowerCase();
    return t.includes('multisocket') || t.includes('multi socket') || t.includes('socket');
  }

  /** Retorna true si el contacto N del MultiSocket en el detalle está encendido */
  getContactoEstadoDetalle(contacto: 1 | 2 | 3 | 4): boolean {
    const id = this.dispositivosService.selectedDevice()?.sk_aparato_id;
    return id ? this.dispositivosService.getContactoEstado(id, contacto) : false;
  }

  getActiveContactCountDetalle(): number {
    const id = this.dispositivosService.selectedDevice()?.sk_aparato_id;
    return id ? this.dispositivosService.getActiveContactCount(id) : 0;
  }

  toggleContactoDetalle(contacto: 1 | 2 | 3 | 4): void {
    const device = this.dispositivosService.selectedDevice();
    if (device) {
      this.dispositivosService.toggleContacto(device, contacto);
    }
  }
}
</file>

<file path="src/app/dashboard/inicio/inicio.html">
<div class="inicio-page">
  <section class="stats-grid card">
    <article class="stat-card stat-card--teal">
      <span class="stat-ico">
        <svg [lucideIcon]="getDeviceIcon('smartphone')"></svg>
      </span>
      <div class="stat-copy">
        <p class="stat-label">Dispositivos</p>
        <p class="stat-number">{{ inicioService.stats()?.dispositivosVinculados ?? 0 }}</p>
        <p class="stat-sub">{{ inicioService.stats()?.devicesOnline ?? 0 }} conectados</p>
      </div>
    </article>

    <article class="stat-card stat-card--teal">
      <span class="stat-ico">
        <svg [lucideIcon]="getDeviceIcon('hand')"></svg>
      </span>
      <div class="stat-copy">
        <p class="stat-label">Gestos</p>
        <p class="stat-number">{{ inicioService.stats()?.activeAutomations ?? 0 }}</p>
        <p class="stat-sub">{{ inicioService.stats()?.automatizaciones ?? 0 }} activos</p>
      </div>
    </article>

    <article class="stat-card stat-card--teal">
      <span class="stat-ico">
        <svg [lucideIcon]="getDeviceIcon('bolt')"></svg>
      </span>
      <div class="stat-copy">
        <p class="stat-label">Acciones realizadas</p>
        <p class="stat-number">{{ inicioService.stats()?.accionesHoy ?? 0 }}</p>
        <p class="stat-sub">Hoy</p>
      </div>
    </article>

    <article class="stat-card stat-card--teal">
      <span class="stat-ico">
        <svg [lucideIcon]="getDeviceIcon('home')"></svg>
      </span>
      <div class="stat-copy">
        <p class="stat-label">Casas</p>
        <p class="stat-number">{{ casasService.casas().length }}</p>
        <p class="stat-sub">Ubicaciones</p>
      </div>
    </article>

    <article class="stat-card stat-card--teal">
      <span class="stat-ico">
        <svg [lucideIcon]="getDeviceIcon('layout-dashboard')"></svg>
      </span>
      <div class="stat-copy">
        <p class="stat-label">Dispositivos activos</p>
        <p class="stat-number">{{ inicioService.stats()?.dispositivosActivos ?? 0 }}</p>
        <p class="stat-sub">Últimas 2 horas</p>
      </div>
    </article>
  </section>

  <section class="charts-grid card">
    <article class="chart-card radial-box">
      <div class="chart-header chart-header--space">
        <div>
          <h3 class="chart-title">Consumo por Dispositivo</h3>
          <p class="chart-subtitle">Distribución de energía</p>
        </div>
        <span class="range-pill active-pill" style="pointer-events: none; font-size: 0.75rem; padding: 0.4rem 0.7rem;">
          {{ donaLabelPeriodo() }}
        </span>
      </div>
      <div class="chart-body chart-body--radial">
        <app-dynamic-chart
          chartType="donut"
          [series]="eficienciaSeries()"
          [labels]="eficienciaLabels()"
          [colors]="eficienciaColors"
          [height]="280"
          valueFormatKind="kwh"
          [additionalOptions]="{
            plotOptions: {
              pie: {
                donut: {
                  size: '60%',
                  labels: {
                    show: true,
                     name: {
                      show: true,
                      fontSize: '14px',
                      color: '#ffffff',
                      formatter: donutNameFormatter
                    },
                    value: {
                      show: true,
                      fontSize: '16px',
                      fontWeight: 700,
                      color: '#ffffff',
                      formatter: donutValueFormatter
                    },
                    total: {
                      show: true,
                      label: 'Total',
                      color: '#ffffff',
                      fontSize: '13px',
                      formatter: donutTotalFormatter
                    }
                  }
                }
              }
            },
            legend: {
              show: true,
              position: 'bottom',
              horizontalAlign: 'center',
              labels: { colors: '#ffffff' },
              markers: { width: 10, height: 10, radius: 10 },
              itemMargin: { horizontal: 8, vertical: 4 }
            },
            dataLabels: { enabled: false }
          }">
        </app-dynamic-chart>
      </div>
    </article>

    <article class="chart-card chart-card--wide">
      <div class="chart-header chart-header--space" style="align-items: flex-start;">
        <div>
          <h3 class="chart-title">Consumo Histórico</h3>
          <div style="display: flex; gap: 0.5rem; margin-top: 0.75rem;">
            <button class="range-pill" [class.active-pill]="periodoSeleccionado() === 'hoy'" (click)="setPeriodo('hoy')" type="button">Hoy</button>
            <button class="range-pill" [class.active-pill]="periodoSeleccionado() === 'semana'" (click)="setPeriodo('semana')" type="button">Semana</button>
            <button class="range-pill" [class.active-pill]="periodoSeleccionado() === 'mes'" (click)="setPeriodo('mes')" type="button">Mes</button>
            <button class="range-pill" [class.active-pill]="periodoSeleccionado() === 'año'" (click)="setPeriodo('año')" type="button">Año</button>
          </div>
        </div>
        <div style="text-align: right;">
          <h3 style="font-size: 1.5rem; font-weight: bold; margin: 0;">{{ yAxisFormatter(consumoTotalKwh()) }} kWh</h3>
          <p style="opacity: 0.8; font-size: 0.9rem; margin: 0; margin-top: 0.2rem;">&approx; {{ costoTotal() | currency:'MXN':'symbol':(costoTotal() < 0.01 && costoTotal() > 0 ? '1.4-4' : '1.2-2') }}</p>
        </div>
      </div>
      <div class="chart-body" style="padding-bottom: 1rem;">
        <app-dynamic-chart
          chartType="bar"
          [series]="actividadSeries()"
          [categories]="actividadCategorias()"
          [colors]="['#ffffff']"
          [height]="300"
          [additionalOptions]="{
            plotOptions: { bar: { borderRadius: 4, columnWidth: '40%' } },
            dataLabels: { enabled: false },
            yaxis: {
              labels: {
                style: { colors: ['rgba(255,255,255,0.8)'] },
                formatter: yAxisFormatter
              },
              forceNiceScale: true,
              decimalsInFloat: 4,
              min: 0,
              max: consumoTotalKwh() === 0 ? 1 : undefined
            },
            xaxis: {
              categories: actividadCategorias(),
              labels: { style: { colors: 'rgba(255,255,255,0.8)' } }
            },
            grid: {
              show: true,
              borderColor: 'rgba(255,255,255,0.16)',
              strokeDashArray: 0,
              position: 'back',
              xaxis: { lines: { show: false } },
              yaxis: { lines: { show: true } }
            },
            tooltip: {
              y: { formatter: tooltipFormatter }
            }
          }">
        </app-dynamic-chart>
      </div>
    </article>
  </section>

  <section class="content-grid card">
    <article class="panel-card panel-card--device">
      <div class="panel-head">
        <div class="panel-head-left">
          <span class="panel-icon-main">
            <svg [lucideIcon]="getDeviceIcon('layout-dashboard')"></svg>
          </span>
          <div>
            <h3 class="panel-title">Dispositivos conectados</h3>
            <p class="panel-subtitle">Dispositivos vinculados a tu sistema</p>
          </div>
        </div>
        <button class="text-link-box" type="button" routerLink="/dashboard/dispositivos">
          <svg [lucideIcon]="getDeviceIcon('layout-dashboard')" [size]="14"></svg>
          Ver todos
        </button>
      </div>

      <div class="devices-strip">
        @for (device of displayedDevices(); track device.sk_aparato_id; let i = $index) {
          <div class="device-chip-new">
            <div class="chip-ico-circle">
              <svg [lucideIcon]="getDeviceIcon(device.tipo_aparato || device.icono)" class="panel-icon-main"></svg>
            </div>
            <strong>{{ device.nombre_aparato }}</strong>
            <span>{{ device.tipo_aparato }}</span>
            <div class="status-pill" [class.on]="connectedDevices().includes(device.mac_bluetooth || '')">
              <span class="dot"></span>
              {{ connectedDevices().includes(device.mac_bluetooth || '') ? 'En línea' : 'Desconectado' }}
            </div>
          </div>
        }

        @if (displayedDevices().length === 0) {
          <div class="notif-empty" style="grid-column: span 3;">
            <p>No hay dispositivos conectados</p>
          </div>
        }
      </div>
    </article>

    <article class="panel-card panel-card--dark">
      <div class="panel-head">
        <div class="panel-head-left">
          <span class="panel-icon-main">
            <svg [lucideIcon]="getGestureIcon('hand')"></svg>
          </span>
          <div>
            <h3 class="panel-title">Gestos</h3>
            <p class="panel-subtitle">Gestos vinculados a tu sistema</p>
          </div>
        </div>
        <button class="text-link-box" type="button" routerLink="/dashboard/gestos">
          <svg [lucideIcon]="getGestureIcon('hand')" [size]="14"></svg>
          Ver todos
        </button>
      </div>

      <div class="automation-list">
        @for(gesto of displayedGestos(); track gesto.sk_gesto_id; let i = $index){
        <div class="automation-row">
          <span class="automation-icon automation-icon--moon">
            <svg [lucideIcon]="getGestureIcon(gesto.icono)"></svg>
          </span>
          <div class="automation-copy">
            <strong>{{gesto.nombre_gesto}}</strong>
            <span>{{ gesto.estado || (gesto.activo ? 'Activo' : 'Inactivo') }}</span>
          </div>
        </div>
        }
      </div>
    </article>
  </section>


</div>
</file>

<file path="src/app/control/control.html">
<div class="control-page-wrapper">

  <!-- ESTADOS DE CARGA Y ERROR -->
  @if (loading()) {
    <div class="empty-state">
      <svg lucideSun [size]="24" class="spin" style="color: var(--cafe-primary);"></svg>
      <p>Cargando dispositivos…</p>
    </div>
  }

  @if (error()) {
    <div class="empty-state">
      <svg lucideTriangleAlert [size]="24" style="color: var(--red);"></svg>
      <p>{{ error() }}</p>
    </div>
  }

  @if (!loading() && !error()) {
    <section class="asociados-section">
      <div class="asociados-head">
        <h2 class="section-title-main">Dispositivos Asociados</h2>
        <p class="section-subtitle-main">Dispositivos vinculados a gestos y automatizaciones</p>
      </div>

      <!-- ROW DE CATEGORÍAS (Solo visibles si tienen dispositivos) -->
      <div class="categories-row">
        <!-- Tarjeta para Ver Todo -->
        <div class="category-card"
             [class.is-active]="tipoSeleccionado() === 'Todos los tipos'"
             (click)="selectTipo('Todos los tipos')">
          <div class="category-icon-circle all">
            <svg lucideLayoutDashboard></svg>
          </div>
          <div class="category-info">
            <h3>Ver Todo</h3>
            <p>{{ dispositivos().length }} dispositivos</p>
          </div>
          <button class="category-arrow-btn">
            <svg lucideChevronDown style="transform: rotate(-90deg);"></svg>
          </button>
        </div>

        @for (t of tiposConDispositivos(); track t.sk_aparato_tipo_id) {
          <div class="category-card"
               [class.is-active]="tipoSeleccionado() === t.nombre_tipo"
               (click)="selectTipo(t.nombre_tipo)">

            <div class="category-icon-circle" [class]="t.nombre_tipo.toLowerCase().replace(' ', '-')">
              <svg [lucideIcon]="getDeviceIcon(t.icono)"></svg>
            </div>

            <div class="category-info">
              <h3>{{ t.nombre_tipo }}</h3>
              <p>{{ getDeviceCount(t.nombre_tipo) }} dispositivos</p>
            </div>

            <button class="category-arrow-btn">
              <svg lucideChevronDown style="transform: rotate(-90deg);"></svg>
            </button>
          </div>
        }
      </div>
    </section>

    <!-- PANEL DE DETALLE -->
    <section class="detail-panel">
      <header class="detail-header">
        <div class="detail-label-group">
          <span class="status-dot" [class]="tipoSeleccionado().toLowerCase().replace(' ', '-')"></span>
          <div>
            <h3 class="detail-title">
              {{ tipoSeleccionado() === 'Todos los tipos' ? 'Todos los Dispositivos' : tipoSeleccionado() }}
            </h3>
            <p class="detail-subtitle">Gestiona tus equipos vinculados</p>
          </div>
        </div>
        <a class="ver-todo-link" [routerLink]="['/dashboard/dispositivos']">
          Ver Todo
          <svg lucideChevronDown [size]="14" style="transform: rotate(-90deg);"></svg>
        </a>
      </header>

      <div class="detail-content">
        <!-- GRID DE DISPOSITIVOS -->
        @if (dispositivosFiltrados().length > 0) {
          <div class="devices-grid">
            @for (d of dispositivosFiltrados(); track d.id) {
              <div class="device-control-card" [class.is-on]="isDeviceOn(d)">
                <div class="device-card-head">
                  <span class="device-type-icon" [class.on]="isDeviceOn(d)">
                    <svg [lucideIcon]="getDeviceIcon(d.icono)"></svg>
                  </span>

                  <!-- El MultiSocket tiene sus propios botones C1-C4 independientes. -->
                  @if (!isMultisocket(d)) {
                    <button class="toggle-power-btn" [class.active]="d.encendido" (click)="toggleDevice(d)">
                       <svg lucidePower></svg>
                    </button>
                  }
                </div>

                <div class="device-card-body">
                  <strong>{{ d.nombre_aparato }}</strong>
                  <p class="location-text">{{ d.ubicacion || 'Sin ubicación' }}</p>

                  <!-- SOLO SE PERMITE ENCENDER/APAGAR -->
                  @if (d.tipo_aparato.toLowerCase() === 'cámara') {
                    <div class="camera-container" style="margin-top: 1rem; border-radius: 8px; overflow: hidden; background: #000; width: 100%;">
                       <app-camara [deviceKey]="d.mac_bluetooth || ''"></app-camara>
                    </div>
                  }

                  <!-- MULTISOCKET -->
                  @if (isMultisocket(d)) {
                    <div class="multisocket-panel">
                      <p class="multisocket-label">Contactos independientes</p>
                      <div class="multisocket-grid">

                        @for (contacto of [1, 2, 3, 4]; track contacto) {
                          <button
                            class="socket-btn"
                            [class.socket-on]="getContactoEstado(d, $any(contacto))"
                            (click)="toggleContacto(d, $any(contacto))"
                            [id]="'socket-' + d.id + '-contacto-' + contacto"
                            [attr.aria-label]="'Contacto ' + contacto + (getContactoEstado(d, $any(contacto)) ? ' encendido' : ' apagado')">

                            <span class="socket-icon">
                              <svg lucidePower [size]="16"></svg>
                            </span>
                            <span class="socket-number">C{{ contacto }}</span>
                            <span class="socket-state-label">
                              {{ getContactoEstado(d, $any(contacto)) ? 'ON' : 'OFF' }}
                            </span>
                          </button>
                        }

                      </div>
                    </div>
                  }
                </div>

                <div class="device-card-footer">
                  @if (isMultisocket(d)) {
                    <!-- Para MultiSocket mostramos cuántos contactos están activos -->
                    <div class="status-pill" [class.on]="isDeviceOn(d)">
                      <span class="dot"></span>
                      {{ getActiveContactCount(d) }}/4 ACTIVOS
                    </div>
                  } @else {
                    <div class="status-pill" [class.on]="d.encendido">
                      <span class="dot"></span>
                      {{ d.encendido ? 'ENCENDIDO' : 'APAGADO' }}
                    </div>
                  }
                </div>
              </div>
            }
          </div>
        } @else {
          <!-- ESTADO VACÍO -->
          <div class="empty-detail-state">
            <div class="empty-illustration">
              <div class="lamp-graphic">
                 <svg [lucideIcon]="getDeviceIcon(tipoSeleccionado())" [size]="60" style="color: var(--cafe-primary); opacity: 0.8;"></svg>
              </div>
            </div>
            <div class="empty-text-group">
              <h3>No hay {{ tipoSeleccionado().toLowerCase() }} en línea</h3>
              <p>Asegúrate de que estén vinculadas y conectadas a la corriente.</p>
            </div>
          </div>
        }
      </div>
    </section>
  }
</div>
</file>

<file path="src/app/dashboard/dashboard.css">
/* ═══════════════════════════════════════
   1. RESET & BASE
   ═══════════════════════════════════════ */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-body);
  background: #ffffff;
  color: var(--cafe-dark);
  height: 100dvh;
}

/* ═══════════════════════════════════════
   2. LAYOUT PRINCIPAL (GRID)
   ═══════════════════════════════════════ */
.dashboard-wrapper {
  display: grid;
  grid-template-columns: 80px 1fr;
  grid-template-rows: auto 1fr;
  grid-template-areas:
    "sidebar topbar"
    "sidebar main";
  height: 100dvh;
  overflow: hidden;
  background: #000000;
  /* Fondo base negro para eliminar líneas blancas en el desenfoque */
  transition: grid-template-columns 0.25s ease-in-out;
}

.top-bar {
  grid-area: topbar;
  background: #ffffff;
  padding: 1.5rem 2.25rem;
  position: relative;
  z-index: 20;
}

.dashboard-main {
  grid-area: main;
  display: flex;
  flex-direction: column;
  gap: 1.75rem;
  overflow-y: auto;
  padding: 0 2.25rem 2rem 2.25rem;
  background: #ffffff;
  min-width: 0;
}

/* ═══════════════════════════════════════
   3. SIDEBAR (Auto-expandible)
   ═══════════════════════════════════════ */
.sidebar {
  grid-area: sidebar;
  width: 80px;
  flex-shrink: 0;
  background: var(--cafe-dark);
  display: flex;
  flex-direction: column;
  padding: 1.5rem 0;
  overflow-y: auto;
  overflow-x: hidden;
  z-index: 100;
  transition: width 0.25s ease-in-out;
}

.sidebar:hover {
  width: 260px;
}

/* ✅ ALINEACIÓN Y CENTRADO DE ICONOS EN SIDEBAR COLAPSADO (Para máxima fidelidad con la imagen) */
.sidebar:not(:hover) .nav-item {
  padding: 0 14px;
}

.sidebar-logo {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 1.5rem 1.25rem;
  margin-left: 12px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  margin-bottom: 0;
  overflow: visible;
  position: relative;
  z-index: 2;
  transition: width 0.25s ease-in-out;
}

.sidebar:hover .sidebar-logo {
  width: 260px;
}

/* ✅ CONEXIÓN LOGO ↔ INDICADOR: Removido para mantener la separación y estilo de tarjeta */

.logo-icon {
  width: 32px;
  height: 32px;
  padding: 0;
  object-fit: contain;
  flex-shrink: 0;
  margin-right: 0.75rem;
  background: transparent !important;
}

.logo-text {
  font-family: var(--font-title);
  font-weight: 800;
  color: #fff;
  font-size: 1.2rem;
  opacity: 0;
  width: 0;
  transition: opacity 0.2s, width 0.2s;
  white-space: nowrap;
}

.sidebar:hover .logo-text {
  opacity: 1;
  width: auto;
}

.sidebar-nav {
  position: relative;
  display: flex;
  flex-direction: column;
  flex: 1;
  /* Overflow visible para que ::before del indicador pueda subir al área del logo */
  overflow: visible;
  /* Padding-top pequeño para que el primer nav-item tenga un pequeño margen */
  padding-top: 0.5rem;
}

.nav-spacer {
  flex: 1;
  min-height: 20px;
}

.nav-active-indicator {
  position: absolute;
  top: 0;
  left: 12px;
  width: calc(100% - 12px);
  height: 48px;
  background: #ffffff;
  border-radius: 30px 0 0 30px;
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 0;
  pointer-events: none;
}

/* ✅ CURVA CÓNCAVA EN EL INDICADOR */
.nav-active-indicator::before,
.nav-active-indicator::after {
  content: "";
  position: absolute;
  right: 0;
  width: 20px;
  height: 20px;
  background: transparent;
  pointer-events: none;
}

.nav-active-indicator::before {
  top: -20px;
  border-radius: 0 0 20px 0;
  box-shadow: 5px 5px 0 5px #ffffff;
}

.nav-active-indicator::after {
  bottom: -20px;
  border-radius: 0 20px 0 0;
  box-shadow: 5px -5px 0 5px #ffffff;
}

/* ✅ CONFIGURACIÓN DEL PRIMER ÍTEM ACTIVO (DASHBOARD):
   - El indicador se ajusta a translateY(0) para quedar pegado a la línea de separación.
   - Eliminar padding-top del nav para que el primer item quede pegado al logo.
   - Altura especial de 56px, esquina superior lisa y esquina inferior muy redondeada (border-radius: 0 0 0 45px).
   - Ocultar ::before para que no se traslape con la cabecera. */
.first-item-active .sidebar-nav {
  padding-top: 0 !important;
  margin-top: -8px !important;
  /* Desplaza el contenedor hacia arriba para pegar el Dashboard a la línea de separación */
}

.first-item-active .sidebar-nav .nav-active-indicator {
  transform: translateY(0) !important;
  border-radius: 6px 0 0 30px;
}

/* Se oculta el ::before (curva cóncava superior derecha) ya que el primer elemento se alinea con el borde del logo */
.first-item-active .sidebar-nav .nav-active-indicator::before {
  display: none;
}

.nav-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 1.25rem;
  margin-left: 12px;
  height: 48px;
  /* Altura fija para el indicador */
  border-radius: 30px 0 0 30px;
  white-space: nowrap;
  font-size: 0.9rem;
  color: rgba(255, 255, 255, 0.72);
  text-decoration: none;
  cursor: pointer;
  user-select: none;
  transition: color 0.3s ease;
  z-index: 1;
}

/* El primer elemento (Dashboard) tiene la esquina superior izquierda apenas redondeada (6px) para un acabado sutil contra la línea, e inferior estándar (30px) */
.sidebar-nav .nav-item:first-of-type {
  border-radius: 6px 0 0 30px;
}

.nav-item:hover {
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
}

.nav-item.active {
  color: var(--cafe-dark) !important;
  font-weight: 600;
  background: transparent !important;
}

.nav-item.active .nav-icon,
.nav-item.active .nav-icon-no-mask {
  opacity: 1;
  color: var(--cafe-dark);
}

.nav-icon,
.icon-mask {
  display: inline-block;
  width: 24px;
  height: 24px;
  flex-shrink: 0;
}

.nav-icon-no-mask {
  display: inline-block;
  width: 28px;
  height: 28px;
  margin-right: 0.75rem;
  opacity: 0.6;
  flex-shrink: 0;
}

.nav-icon {
  width: 28px;
  height: 28px;
  margin-right: 0.75rem;
  opacity: 0.6;
}

.nav-item.active .nav-icon {
  opacity: 1;
  color: var(--cafe-primary);
}

.nav-text {
  opacity: 0;
  width: 0;
  overflow: hidden;
  transition: opacity 0.2s, width 0.2s;
  white-space: nowrap;
}

.sidebar:hover .nav-text {
  opacity: 1;
  width: auto;
}

.sidebar-bottom {
  margin-top: auto;
  display: flex;
  flex-direction: column;
}

/* ═══════════════════════════════════════
   7. RESPONSIVE DESIGN
   ═══════════════════════════════════════ */

/* Ocultar botones móviles por defecto en escritorio */
.mobile-menu-btn,
.mobile-close-btn {
  display: none;
}

/* PANTALLAS MEDIANAS (Sidebar se superpone al contenido) */
@media (max-width: 1250px) and (min-width: 769px) {
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 80px;
    z-index: 1000;
  }

  .sidebar:hover {
    width: 260px;
  }

  /* Equilibrio perfecto: desenfoque medio y oscurecimiento moderado */
  .dashboard-wrapper:has(.sidebar:hover) .dashboard-main,
  .dashboard-wrapper:has(.sidebar:hover) .top-bar {
    filter: blur(8px) brightness(0.65);
    transform: scale(1.03);
    /* Ligero escalado para ocultar bordes sin deformar */
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .dashboard-wrapper {
    grid-template-columns: 80px 1fr;
    /* Mantenemos el grid base para que no salte el contenido */
  }
}

/* MÓVIL Y TABLET (Ajustes de cabecera) */
@media (max-width: 1250px) {
  .hero-panel {
    gap: 0.5rem;
  }

  .welcome-text {
    font-size: clamp(1rem, 2.5vw, 1.3rem) !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }

  /* Fecha como botón compacto */
  .date-pill-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: white;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 12px;
    cursor: pointer;
    padding: 0;
    pointer-events: auto !important;
  }

  .date-text-wrapper {
    display: none;
  }

  .mobile-date-panel {
    display: block !important;
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: 180px;
    background: white;
    padding: 1rem;
    border-radius: 15px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    border: 1px solid rgba(43, 191, 170, 0.2);
    z-index: 1001;
    text-align: right;
    animation: fadeInDown 0.2s ease;
  }

  .mobile-date-panel strong {
    display: block;
    font-size: 0.9rem;
    color: var(--cafe-dark);
  }

  .mobile-date-panel span {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 4px;
  }
}

/* ESPECÍFICO MÓVIL (Sidebar y otros ajustes) */
@media (max-width: 768px) {
  .dashboard-wrapper {
    grid-template-columns: 0 1fr;
  }

  .mobile-menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--cafe-dark);
    color: white;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    z-index: 30;
    flex-shrink: 0;
  }

  .sidebar {
    position: fixed;
    top: 0;
    left: -280px;
    bottom: 0;
    width: 260px;
    padding: 1.5rem 0;
    transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 10px 0 30px rgba(0, 0, 0, 0.2);
    z-index: 1000;
  }

  .dashboard-wrapper.menu-open .sidebar {
    left: 0;
  }

  .sidebar-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 900;
    backdrop-filter: blur(2px);
  }

  .logo-text,
  .nav-text {
    display: block !important;
    opacity: 1 !important;
    width: auto !important;
    overflow: visible !important;
    margin-left: 0.5rem;
  }

  .dashboard-main,
  .top-bar {
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .notif-button {
    width: 40px;
    height: 40px;
  }
}

/* Escritorio grande - Sidebar NO se superpone, empuja el contenido */
@media (min-width: 1251px) {
  .dashboard-wrapper:has(.sidebar:hover) {
    grid-template-columns: 260px 1fr;
  }

  .date-pill-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--white);
    border: 1px solid rgba(26, 46, 42, 0.08);
    border-radius: 16px;
    padding: 0.75rem 1rem;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);
    cursor: pointer;
    pointer-events: auto;
  }

  .mobile-date-panel {
    display: none !important;
  }
}

.date-container {
  position: relative;
}

.weather-date-panel {
  position: absolute;
  top: calc(100% + 12px);
  right: 0;
  width: min(335px, calc(100vw - 2rem));
  min-height: 405px;
  padding: 2.05rem 1.35rem 0;
  background: #ffffff;
  border: 1px solid rgba(226, 232, 240, 0.72);
  border-radius: 22px;
  box-shadow: 0 20px 44px rgba(15, 23, 42, 0.14);
  z-index: 1001;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.05rem;
  animation: fadeInDown 0.22s ease;
}

.weather-orbit {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.15rem;
  width: 100%;
}

.weather-circle {
  width: 96px;
  height: 96px;
  border: none;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: #f5b700;
  background:
    radial-gradient(circle at 55% 45%, rgba(255, 255, 255, 0.92), rgba(232, 247, 246, 0.95) 62%, rgba(229, 244, 244, 0.9));
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.95), 0 12px 24px rgba(15, 23, 42, 0.08);
