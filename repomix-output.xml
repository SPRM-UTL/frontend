<div class="dispositivos-container">
  <div class="page-header">
    <div>
      <p class="page-subtitle">Maneja y controla todos tus dispositivos conectados</p>
    </div>
  </div>

  <div class="search-filter-row">
    <div class="search-wrapper">
      <svg lucideSearch class="search-icon" [size]="18"></svg>
      <input class="search-input"
             type="text"
             placeholder="Buscar dispositivo..."
             [value]="searchQuery()"
             (input)="onSearch($any($event.target).value)" />
    </div>

    <div class="filter-wrapper">
      <div class="custom-dropdown">
        <button class="dropdown-trigger" (click)="toggleFilter()">
          <svg lucideFilter class="filter-icon" [size]="16"></svg>
          <span class="trigger-label">{{ selectedFilterLabel() }}</span>
          <svg lucideChevronDown class="arrow-icon" [size]="14" [style.transform]="isFilterOpen() ? 'rotate(180deg)' : 'rotate(0deg)'" style="transition: transform 0.2s;"></svg>
        </button>

        @if (isFilterOpen()) {
          <div class="dropdown-menu">
            <div class="dropdown-option" [class.active]="selectedFilter() === ''" (click)="selectFilter('', 'Todos los tipos')">Todos los tipos</div>
            <div class="dropdown-option" [class.active]="selectedFilter() === 'Audifonos'" (click)="selectFilter('Audifonos', 'Audifonos')">Audifonos</div>
            <div class="dropdown-option" [class.active]="selectedFilter() === 'Bocinas'" (click)="selectFilter('Bocinas', 'Bocinas')">Bocinas</div>
            <div class="dropdown-option" [class.active]="selectedFilter() === 'Focos'" (click)="selectFilter('Focos', 'Focos')">Focos</div>
            <div class="dropdown-option" [class.active]="selectedFilter() === 'Luces'" (click)="selectFilter('Luces', 'Luces')">Luces</div>
            <div class="dropdown-option" [class.active]="selectedFilter() === 'Ventilador'" (click)="selectFilter('Ventilador', 'Ventilador')">Ventilador</div>
            <div class="dropdown-option" [class.active]="selectedFilter() === 'Television'" (click)="selectFilter('Television', 'Television')">Television</div>
            <div class="dropdown-option" [class.active]="selectedFilter() === 'Sockets'" (click)="selectFilter('Sockets', 'Sockets')">Sockets</div>
            <div class="dropdown-option" [class.active]="selectedFilter() === 'Asistente'" (click)="selectFilter('Asistente', 'Asistente')">Asistente</div>
          </div>
        }
      </div>
    </div>
  </div>

  <div class="devices-section">
    <div class="section-header">
      <div class="section-title-row">
        <div class="wifi-circle">
          <svg lucideWifi [size]="20"></svg>
        </div>
        <div>
          <h2 class="section-title">Todos los dispositivos</h2>
          <p class="section-sub">{{ filteredDevices().length }} dispositivos en linea</p>
        </div>
      </div>
    </div>

    @if (loading()) {
      <div class="table-feedback">
        <svg lucideSun [size]="20" class="spin"></svg>
        Cargando dispositivos...
      </div>
    }

    @if (error()) {
      <div class="table-feedback table-feedback--error">
        <svg lucideTriangleAlert [size]="18"></svg>
        {{ error() }}
      </div>
    }

    @if (!loading()) {
      <div class="table-wrapper">
        <table class="devices-table">
          <thead>
            <tr>
              <th>DISPOSITIVOS</th>
              <th>TIPO</th>
              <th>ACCION</th>
              <th>BLUETOOTH</th>
              @if (showActions()) {
                <th>ACCIONES</th>
              }
            </tr>
          </thead>
          <tbody>
            @for (device of filteredDevices(); track device.sk_aparato_id) {
              <tr class="device-row"
                  (click)="verDetalle(device)"
                  [class.is-selected]="devicesService.selectedDevice()?.sk_aparato_id === device.sk_aparato_id"
                  style="cursor: pointer;">
                <td class="device-cell">
                 <div class="device-avatar">
                   <svg [lucideIcon]="getDeviceIcon(device.icono)" [size]="20"></svg>
                 </div>
                 <div class="device-info">
                   <span class="device-name">{{ device.nombre_aparato }}</span>
                   <div class="status-pill-connection" [class.offline]="!connectedDevices().includes(device.mac_bluetooth || '')">
                     <span class="dot"></span>
                     {{ connectedDevices().includes(device.mac_bluetooth || '') ? 'En línea' : 'Desconectado' }}
                   </div>
                 </div>
                </td>

                <td class="type-cell">{{ device.tipo_aparato }}</td>

                 <td class="power-cell">
                   @if (isMultisocket(device)) {
                     <div class="multisocket-status-badge">
                       <span class="ms-dot" [class.ms-dot--on]="getMultisocketActiveCount(device) > 0"></span>
                       <span class="ms-label">{{ getMultisocketActiveCount(device) }}/4 activos</span>
                     </div>
                   } @else {
                     <div class="action-btn-status"
                          [class.on]="device.estado_encendido"
                          (click)="onToggleDevice(device); $event.stopPropagation()">
                       <svg lucidePower [size]="14"></svg>
                       <span>{{ device.estado_encendido ? 'Encendido' : 'Apagado' }}</span>
                     </div>
                   }
                 </td>

                <td class="bt-cell">{{ device.nombre_bluetooth || 'N/A' }}</td>

                @if (showActions()) {
                  <td class="actions-cell">
                    <div class="action-buttons-group">
                      <button class="row-action-btn" title="Cerrar sesion">
                        <svg lucideLogOut [size]="18"></svg>
                      </button>
                      <button class="row-action-btn" title="Ajustes">
                        <svg lucideBolt [size]="18"></svg>
                      </button>
                      <button class="row-action-btn" title="Mas opciones">
                        <svg lucideChevronDown [size]="18"></svg>
                      </button>
                    </div>
                  </td>
                }
              </tr>
            } @empty {
              @if (!loading()) {
                <tr>
                  <td [attr.colspan]="showActions() ? 5 : 4">
                    <div class="empty-state">
                      <svg lucideSearch [size]="32" style="opacity: 0.3;"></svg>
                      <p>No se encontraron dispositivos</p>
                    </div>
                  </td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>
    }

    <footer class="table-footer">
      <p class="results-count">Mostrando 1 a {{ filteredDevices().length }} de {{ filteredDevices().length }} dispositivos</p>
      <div class="pagination">
        <button class="page-btn"><svg lucideChevronDown [size]="12" style="transform: rotate(90deg);"></svg></button>
        <button class="page-btn active">1</button>
        <button class="page-btn"><svg lucideChevronDown [size]="12" style="transform: rotate(-90deg);"></svg></button>
      </div>
    </footer>
  </div>
</div>
