<file path="src/app/control/control.css">
:host {
  display: block;
}

@keyframes slideUpFromBottom {
  from {
    opacity: 0;
    transform: translateY(100vh);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.control-page-wrapper {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  animation: slideUpFromBottom 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.asociados-section {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.section-title-main {
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--cafe-dark);
}

.section-subtitle-main {
  font-size: 0.85rem;
  color: #94a3b8;
}

.categories-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.25rem;
}

.category-card {
  background: var(--cafe-primary);
  border: 1.5px solid rgba(255, 255, 255, 0.2);
  border-radius: 20px;
  padding: 1.25rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4px 15px rgba(43, 191, 170, 0.15);
}

.category-card:hover {
  background: #23a895; /* Un verde más fuerte/oscuro al hacer hover */
  border-color: rgba(255, 255, 255, 0.4);
  transform: translateY(-2px);
}

.category-card.is-active {
  background: #1e9282; /* Aún más oscuro cuando está activo */
  border-color: #ffffff;
  box-shadow: 0 8px 25px rgba(43, 191, 170, 0.3);
  transform: translateY(-2px);
}

/* Forzar que todos los textos e íconos dentro de la categoría verde sean blancos */
.category-card .category-info h3 {
  color: #ffffff;
}

.category-card .category-info p {
  color: rgba(255, 255, 255, 0.85);
}

.category-card .category-arrow-btn {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.category-icon-circle {
  width: 50px;
  height: 50px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  /* Fondo unificado para que se vea bien sobre el verde */
  background: rgba(255, 255, 255, 0.2) !important;
  color: #ffffff !important;
}

/* Colores Dinámicos Categorías */
.category-icon-circle.asistente { background: #fdf2f8; color: #db2777; }
.category-icon-circle.audífonos { background: #f0fdf4; color: #16a34a; }
.category-icon-circle.bocinas { background: #f5f3ff; color: #8b5cf6; }
.category-icon-circle.focos { background: #fffbeb; color: #d97706; }
.category-icon-circle.luces { background: #fff7ed; color: #f97316; }
.category-icon-circle.sockets-inteligentes { background: #ecfeff; color: #0891b2; }
.category-icon-circle.televisión { background: #fef2f2; color: #dc2626; }
.category-icon-circle.ventilador { background: #eff6ff; color: #3b82f6; }
.category-icon-circle.all { background: #f1f5f9; color: var(--cafe-primary); }

.category-icon-circle .icon-mask {
  width: 24px;
  height: 24px;
  background-color: currentColor !important;
}

.category-info h3 {
  font-size: 1rem;
  font-weight: 700;
}

.category-info p {
  font-size: 0.8rem;
}

.category-arrow-btn {
  margin-left: auto;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: none;
  display: grid;
  place-items: center;
}

/* DETALLE */
.detail-panel {
  background: var(--cafe-primary);
  border-radius: 24px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 4px 20px rgba(43, 191, 170, 0.2);
  overflow: hidden;
}

.detail-header {
  padding: 1.5rem 2rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-label-group {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.status-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  box-shadow: 0 0 8px currentColor;
  background: #ffffff !important;
  color: #ffffff !important;
}

.detail-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: #ffffff;
}

.detail-subtitle {
  font-size: 0.8rem;
  color: rgba(255, 255, 255, 0.85);
}

.ver-todo-link {
  font-size: 0.85rem;
  font-weight: 600;
  color: #ffffff;
  text-decoration: none;
  background: rgba(255, 255, 255, 0.2);
  padding: 6px 12px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  gap: 4px;
  transition: background 0.3s ease;
}

.ver-todo-link:hover {
  background: rgba(255, 255, 255, 0.3);
}

/* GRID DISPOSITIVOS */
.devices-grid {
  padding: 2rem;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.5rem;
}

.device-control-card {
  background: #f8fafc;
  border: 1px solid rgba(0, 0, 0, 0.03);
  border-radius: 24px;
  padding: 1.5rem;
  transition: all 0.3s;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.device-control-card.is-on {
  background: #ffffff;
  border-color: rgba(43, 191, 170, 0.15);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.04);
}

.device-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.device-type-icon {
  width: 44px;
  height: 44px;
  border-radius: 14px;
  background: #f1f5f9;
  display: grid;
  place-items: center;
  color: #64748b;
  transition: all 0.3s;
}

.device-type-icon.on {
  background: rgba(43, 191, 170, 0.1);
  color: var(--cafe-primary);
}

.device-type-icon .icon-mask {
  width: 24px;
  height: 24px;
  background-color: currentColor !important;
}

.toggle-power-btn {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1px solid #e2e8f0;
  background: #fff;
  color: #94a3b8;
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: all 0.3s;
}

.toggle-power-btn.active {
  background: var(--cafe-primary) !important;
  border-color: var(--cafe-primary) !important;
  color: #fff !important;
  box-shadow: none; /* Quitamos sombra */
}

.toggle-power-btn .icon-mask {
  width: 20px;
  height: 20px;
  background-color: currentColor !important;
}

.toggle-power-btn svg {
  fill: none; /* Aseguramos que solo sea contorno si es necesario */
}

.device-card-body strong {
  display: block;
  font-size: 1rem;
  font-weight: 800;
  color: var(--cafe-dark);
}

.location-text {
  font-size: 0.8rem;
  color: #94a3b8;
  margin-top: 2px;
}

/* CONTROLES EXTRA */
.device-extra-controls {
  margin-top: 0.5rem;
  display: none;
}

.device-extra-controls.visible {
  display: block;
}

/* BARRITA DE AUDIO */
.audio-control-wrapper {
  background: #f8fafc;
  padding: 0.75rem 1rem;
  border-radius: 16px;
}

.audio-buttons-row {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.progress-container {
  flex: 1;
  height: 8px;
  background: #e2e8f0;
  border-radius: 4px;
  position: relative;
  overflow: hidden;
}

.progress-bar {
  position: absolute;
  top: 0; left: 0; bottom: 0;
  background: var(--cafe-primary);
  transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.progress-text {
  position: absolute;
  right: 0; top: -18px;
  font-size: 0.7rem;
  font-weight: 800;
  color: #64748b;
}

/* SLIDER BRILLO */
.control-stepper {
  background: #f8fafc;
  padding: 0.75rem 1rem;
  border-radius: 16px;
}

.slider-container {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.modern-slider {
  flex: 1;
  height: 6px;
  -webkit-appearance: none;
  background: #e2e8f0;
  border-radius: 3px;
  outline: none;
}

.modern-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 16px;
  height: 16px;
  background: var(--cafe-primary);
  border-radius: 50%;
  cursor: pointer;
  border: 2px solid #fff;
}

.val-text {
  font-size: 0.75rem;
  font-weight: 800;
  color: #64748b;
  min-width: 32px;
}

/* SPEED INDICATOR */
.speed-indicator {
  display: flex;
  gap: 6px;
  flex: 1;
  justify-content: center;
}

.speed-indicator .dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #cbd5e1;
  transition: all 0.3s;
}

.speed-indicator .dot.active {
  background: var(--cafe-primary);
  transform: scale(1.2);
}

.step-btn {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  border: 1px solid #e2e8f0;
  background: #fff;
  color: var(--cafe-dark);
  font-weight: 800;
  cursor: pointer;
}

/* FOOTER */
.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 12px;
  border-radius: 99px;
  background: #f1f5f9;
  color: #94a3b8;
  font-size: 0.7rem;
  font-weight: 800;
}

.status-pill.on {
  background: #f0fdf4;
  color: #16a34a;
}

.status-pill .dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
}

/* EMPTY */
.empty-detail-state {
  text-align: center;
  padding: 4rem 2rem;
}

.lamp-graphic {
  width: 100px;
  height: 100px;
  background: #f1f5f9;
  border-radius: 50%;
  display: grid;
  place-items: center;
  margin: 0 auto 1.5rem;
}

@media (max-width: 768px) {
  .devices-grid { grid-template-columns: 1fr; }
}

/* MULTISOCKET */
.multisocket-panel {
  margin-top: 1rem;
  padding: 1.25rem;
  background: #f1f5f9;
  border-radius: 20px;
  border: 1px solid rgba(0, 0, 0, 0.06);
  box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
}

.multisocket-label {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #94a3b8;
  margin-bottom: 0.75rem;
}

.multisocket-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.6rem;
}

.socket-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 1rem 0.5rem;
  border-radius: 16px;
  border: 2px solid #e2e8f0;
  background: #ffffff;
  color: #64748b;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
  overflow: hidden;
  font-family: inherit;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.socket-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--cafe-primary);
  opacity: 0;
  transition: opacity 0.25s ease;
  border-radius: inherit;
}

.socket-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
  border-color: var(--cafe-primary);
  color: var(--cafe-primary);
}

.socket-btn:active {
  transform: scale(0.96);
}

/* Estado ON */
.socket-btn.socket-on {
  background: var(--cafe-primary);
  border-color: var(--cafe-primary);
  color: #ffffff;
  box-shadow: 0 4px 14px rgba(43, 191, 170, 0.35);
}

.socket-btn.socket-on:hover {
  background: #24d4b8;
  border-color: #24d4b8;
  color: #ffffff;
  box-shadow: 0 6px 20px rgba(43, 191, 170, 0.45);
}

.socket-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #f1f5f9;
  color: #94a3b8;
  transition: all 0.25s ease;
}

.socket-btn:hover .socket-icon {
  color: var(--cafe-primary);
  background: rgba(43, 191, 170, 0.1);
}

.socket-btn.socket-on .socket-icon {
  background: rgba(255, 255, 255, 0.25);
  color: #ffffff;
}

.socket-number {
  font-size: 0.85rem;
  font-weight: 800;
  letter-spacing: 0.02em;
  color: var(--cafe-dark);
