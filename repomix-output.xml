/* ── Visor Multimedia Avanzado ──────────────────────── */
.media-viewer-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(8px);
  z-index: 100000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  animation: viewerFadeIn 0.3s ease-out;
}

@keyframes viewerFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.media-viewer-content {
  background: #000000; /* Fondo negro para que resalte el media */
