<file path="src/app/register/register.css">
:host {
  display: block;
  height: 100dvh;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

@keyframes slideUpFromBottom {
  from { opacity: 0; transform: translateY(50px); }
  to { opacity: 1; transform: translateY(0); }
}

.auth-background {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background-color: #223737;
  padding: 2rem;
}

.auth-card {
  display: flex;
  width: 100%;
  max-width: 950px;
  height: auto;
  min-height: 550px;
  background: white;
  border-radius: 12px;
  box-shadow: 0 20px 50px rgba(0,0,0,0.3);
  overflow: hidden;
  animation: slideUpFromBottom 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* ── LEFT SIDE ── */
.auth-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 2.5rem 3.5rem;
  position: relative;
}

.auth-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1.5rem;
}

.logo-mini {
  width: 24px;
  height: 24px;
  border-radius: 4px;
  background: var(--cafe-dark);
  object-fit: cover;
}

.brand-name {
  font-family: var(--font-title, 'Poppins', sans-serif);
  font-weight: 700;
  font-size: 1.1rem;
  color: var(--cafe-primary, #3aafa9);
}

h1 {
  font-size: 2.2rem;
  font-weight: 700;
  color: var(--cafe-dark, #2b7a78);
  line-height: 1.2;
  margin-bottom: 0.5rem;
  font-family: var(--font-title, 'Poppins', sans-serif);
}

h1 span {
  color: var(--cafe-primary, #3aafa9);
}

.auth-subtitle {
  font-size: 0.95rem;
  color: #666;
  margin-bottom: 2rem;
  font-family: var(--font-body, sans-serif);
}

.field {
  margin-bottom: 1.25rem;
}

label {
  display: block;
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--cafe-dark, #2b7a78);
  margin-bottom: 0.5rem;
  font-family: var(--font-heading, sans-serif);
}

.input-wrapper, .password-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
}

.input-icon {
  position: absolute;
  left: 14px;
  color: #a0aab2;
  pointer-events: none;
  z-index: 10;
}

input {
  width: 100%;
  padding: 0.8rem 1.125rem 0.8rem 2.8rem;
  border: 1.5px solid #e2e8f0;
  border-radius: 8px;
  font-size: 0.95rem;
  color: var(--cafe-dark);
  background: #ffffff;
  outline: none;
  transition: border-color 0.2s;
  font-family: var(--font-body);
}

.password-wrapper input {
  padding-right: 50px;
}

input:focus {
  border-color: var(--cafe-primary);
}

.toggle-password {
  position: absolute;
  right: 14px;
  background: none;
  border: none;
  cursor: pointer;
  color: #a0aab2;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.toggle-password:hover {
  color: var(--cafe-primary);
}

.forgot {
  display: block;
  text-align: right;
  font-size: 0.85rem;
  color: var(--cafe-primary);
  text-decoration: none;
  margin-top: 0.5rem;
  font-family: var(--font-body);
}

.btn-primary {
  width: 100%;
  padding: 1rem;
  background: var(--cafe-dark, #2b7a78);
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  margin-top: 1rem;
  transition: background 0.2s;
  font-family: var(--font-body);
}

.btn-primary:hover {
  background: #1f5c5a;
}

.register-link, .login-link {
  text-align: center;
  font-size: 0.9rem;
  color: #666;
  margin-top: 1.5rem;
  font-family: var(--font-body);
}

.register-link a, .login-link a {
  color: var(--cafe-primary);
  text-decoration: none;
  font-weight: 700;
}

footer {
  margin-top: auto;
  text-align: center;
  font-family: var(--font-body);
}

.security-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  color: #666;
  font-size: 0.85rem;
  margin-bottom: 0.3rem;
}

footer p {
  color: #999;
  font-size: 0.8rem;
}

/* ── RIGHT SIDE ── */
.auth-right {
  flex: 1;
  background: var(--cafe-dark, #2b7a78);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.logo-large {
  width: 160px;
  height: 160px;
  object-fit: contain;
  animation: float 3s ease-in-out infinite;
  border-radius: 24px;
  z-index: 2;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-12px);
  }
}

.deco-wave {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 200px;
  background: radial-gradient(circle at 0% 100%, rgba(255,255,255,0.06) 0%, transparent 60%),
              radial-gradient(circle at 100% 100%, rgba(0,0,0,0.08) 0%, transparent 70%);
  z-index: 1;
}

/* ── RESPONSIVE ── */
@media (max-width: 768px) {
  .auth-card {
    height: auto;
    min-height: 600px;
  }
  .auth-right {
    display: none;
  }
  .auth-left {
    padding: 2rem;
  }
}
</file>

<file path="src/app/register/register.html">
<div class="auth-background">
  <div class="auth-card">
    <div class="auth-left">

      <div class="auth-header">
        <img src="icono_manordomo.svg" alt="logo mini" class="logo-mini"/>
        <span class="brand-name">manordomo</span>
      </div>

      <h1>Bienvenido a<br><span>manordomo</span></h1>
      <p class="auth-subtitle">Crea tu cuenta para comenzar.</p>

      <div class="field">
        <label>Nombre y apellido</label>
        <div class="input-wrapper">
          <svg lucideUser class="input-icon" style="width: 20px; height: 20px;"></svg>
          <input type="text" placeholder="Ej. Juan Pérez" [(ngModel)]="nombre" (keypress)="soloLetras($event)"/>
        </div>
      </div>

      <div class="field">
        <label>Email</label>
        <div class="input-wrapper">
          <svg lucideMail class="input-icon" style="width: 20px; height: 20px;"></svg>
          <input type="email" placeholder="ejemplo@email.com" [(ngModel)]="correo"/>
        </div>
      </div>

      <div class="field">
        <label>Contraseña</label>
        <div class="input-wrapper">
          <svg lucideLock class="input-icon" style="width: 20px; height: 20px;"></svg>
          <div class="password-wrapper">
            <input
              [type]="showPassword() ? 'text' : 'password'"
              placeholder="Al menos 8 caracteres"
              [(ngModel)]="contrasenia"
            />
            <button
              type="button"
              class="toggle-password"
              (click)="togglePassword()">
              @if (!showPassword()) {
                <svg lucideEye style="width: 22px; height: 22px;"></svg>
              } @else {
                <svg lucideEyeOff style="width: 22px; height: 22px;"></svg>
              }
            </button>
          </div>
        </div>
      </div>

      <button class="btn-primary" (click)="onRegister()">
        Crear cuenta
      </button>

      <p class="login-link">¿Ya tienes una cuenta? <a routerLink="/">Inicia sesión</a></p>

      <footer>
        <p>© 2026 Todos los derechos reservados</p>
      </footer>

    </div>

    <div class="auth-right">
      <div class="deco-wave"></div>
      <img src="lago.png" alt="logo grande" class="logo-large" />
    </div>
  </div>
</div>
</file>

