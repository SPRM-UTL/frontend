  height: 16px;
  color: #94a3b8;
}

.arrow-icon {
  width: 14px;
  height: 14px;
  color: #94a3b8;
}

.dropdown-menu {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  right: 0;
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
