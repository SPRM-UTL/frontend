}

.weather-info-box {
  width: 100%;
  min-height: 86px;
  border: none;
  border-radius: 18px;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  text-align: left;
  padding: 1rem 1rem 1rem 4.7rem;
  color: #111827;
  box-shadow: none;
