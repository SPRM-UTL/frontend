  color: #94a3b8;
  margin-bottom: 6px;
  text-align: center;
}

.modal-ms-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 5px;
}

.modal-ms-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  padding: 8px 6px;
  border-radius: 10px;
  border: 1.5px solid #e2e8f0;
  background: #f8fafc;
  color: #94a3b8;
  font-size: 0.65rem;
  font-weight: 800;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  font-family: inherit;
  min-width: 44px;
}

.modal-ms-btn:hover {
  transform: translateY(-1px);
  border-color: var(--cafe-primary, #2bbfaa);
  color: var(--cafe-primary, #2bbfaa);
  box-shadow: 0 3px 10px rgba(0,0,0,0.08);
}

.modal-ms-btn:active {
  transform: scale(0.95);
}

.modal-ms-btn--on {
  background: var(--cafe-primary, #2bbfaa);
  border-color: var(--cafe-primary, #2bbfaa);
  color: #ffffff;
  box-shadow: 0 3px 12px rgba(43, 191, 170, 0.35);
}

.modal-ms-btn--on:hover {
  background: #24d4b8;
  border-color: #24d4b8;
  color: #fff;
}
</file>

<file path="src/app/dashboard/dashboard.html">
<div class="dashboard-wrapper"
     [class.sidebar-collapsed]="sidebarCollapsed()"
     [class.menu-open]="menuOpen()"
     (click)="closePanel(); closeMenu(); datePanelOpen.set(false)">

  <!-- ── Overlay móvil ─────────────────────────────────────────────────── -->
  @if (menuOpen()) {
    <div class="sidebar-overlay" (click)="closeMenu()"></div>
  }

  <!-- ── Sidebar ───────────────────────────────────────────────────────── -->
  <aside class="sidebar" [class.first-item-active]="isFirstItemActive()" (click)="$event.stopPropagation()">

    <div class="sidebar-logo">
      <img src="/icons/logo.svg" class="logo-icon" alt="Logo">
      <span class="logo-name">Manordomo</span>
      <button class="mobile-close-btn" (click)="closeMenu()" aria-label="Cerrar menú">
        <svg [lucideIcon]="getDeviceIcon('x')"></svg>
      </button>
    </div>

    <nav class="sidebar-nav">
      <div class="nav-active-indicator" [style.transform]="'translateY(' + indicatorTop() + 'px)'"></div>

      <a class="nav-item" routerLink="/dashboard/inicio"      routerLinkActive="active" (click)="closeMenu()">
        <svg [lucideIcon]="getDeviceIcon('layout-dashboard')" class="nav-icon-no-mask"></svg>
        <span class="nav-text">Dashboard</span>
      </a>
      <a class="nav-item" routerLink="/dashboard/dispositivos" routerLinkActive="active" (click)="closeMenu()">
        <svg [lucideIcon]="getDeviceIcon('smartphone')" class="nav-icon-no-mask"></svg>
        <span class="nav-text">Dispositivos</span>
      </a>
      <a class="nav-item" routerLink="/dashboard/casas" routerLinkActive="active" (click)="closeMenu()">
        <svg [lucideIcon]="getDeviceIcon('home')" class="nav-icon-no-mask"></svg>
        <span class="nav-text">Casas</span>
      </a>
      <a class="nav-item" routerLink="/dashboard/gestos"      routerLinkActive="active" (click)="closeMenu()">
        <svg [lucideIcon]="getDeviceIcon('hand')" class="nav-icon-no-mask"></svg>
        <span class="nav-text">Gestos</span>
      </a>
      <a class="nav-item" routerLink="/dashboard/historial"   routerLinkActive="active" (click)="closeMenu()">
        <svg [lucideIcon]="getDeviceIcon('clock')" class="nav-icon-no-mask"></svg>
        <span class="nav-text">Historial de actividad</span>
      </a>
      <a class="nav-item" routerLink="/dashboard/control"     routerLinkActive="active" (click)="closeMenu()">
        <svg [lucideIcon]="getDeviceIcon('pencil')" class="nav-icon-no-mask"></svg>
        <span class="nav-text">Control</span>
      </a>

      <div class="nav-spacer"></div>

      <a class="nav-item" routerLink="/dashboard/ajustes"     routerLinkActive="active" (click)="closeMenu()">
        <svg [lucideIcon]="getDeviceIcon('bolt')" class="nav-icon-no-mask"></svg>
        <span class="nav-text">Ajustes</span>
      </a>
      <a class="nav-item" routerLink="/dashboard/cuenta"      routerLinkActive="active" (click)="closeMenu()">
        <svg [lucideIcon]="getDeviceIcon('user')" class="nav-icon-no-mask"></svg>
        <span class="nav-text">Cuenta</span>
      </a>
      <a class="nav-item signout" style="cursor:pointer"
         (click)="onLogout(); closeMenu(); $event.stopPropagation()">
        <svg [lucideIcon]="getDeviceIcon('log-out')" class="nav-icon-no-mask"></svg>
        <span class="nav-text">Salir</span>
      </a>
    </nav>
  </aside>

  <!-- ── Top bar ───────────────────────────────────────────────────────── -->
  <header class="top-bar">
    <section class="hero-panel">

      <button class="mobile-menu-btn" aria-label="Abrir menú"
              (click)="toggleMenu(); $event.stopPropagation()">
        <svg [lucideIcon]="getDeviceIcon('menu')" [size]="28"></svg>
      </button>

      <div class="hero-copy">
        <p class="eyebrow">{{ currentTitle() }}</p>
        <h1 class="welcome-text">
          ¡Buenos días, {{ userName() }}!
          <svg [lucideIcon]="getGestureIcon('hand')" [size]="22" class="wave-icon"></svg>
        </h1>
      </div>

      <!-- Acciones: notificaciones + fecha/clima -->
      <div class="hero-actions" (click)="$event.stopPropagation()">

        <!-- Botón de notificaciones -->
        <button class="notif-button" type="button" aria-label="Notificaciones"
                [class.is-active]="panelOpen()"
                (click)="togglePanel()">
          <svg [lucideIcon]="getDeviceIcon('bell')"></svg>
          @if (notifCount() > 0) {
            <span class="notif-badge">{{ notifCount() }}</span>
          }
        </button>

        <!-- Panel de notificaciones -->
        @if (panelOpen()) {
          <section class="notif-panel" role="dialog" aria-label="Panel de notificaciones"
                   (click)="$event.stopPropagation()"
                   (mouseleave)="closePanel()">

            <header class="notif-header">
              <h3>Notificaciones</h3>
              <span class="notif-count-label">{{ notifCount() }} nuevas</span>
            </header>

            @if (panelLoading()) {
              <div class="notif-empty">
                <span class="notif-spin"><svg [lucideIcon]="getDeviceIcon('sun')"></svg></span>
                <p>Cargando notificaciones…</p>
              </div>
            } @else if (panelError()) {
              <div class="notif-empty"><p>{{ panelError() }}</p></div>
            } @else {
              <div class="notif-list">
                @for (n of recentActivities(); track n.id) {
                  <article class="notif-item" [class]="'severity-' + n.severity">
                    <span class="notif-icon">
                      <svg [lucideIcon]="n.icon" [size]="18"></svg>
                    </span>
                    <div class="notif-content">
                      <p class="notif-action">{{ n.title }}</p>
                      <p class="notif-meta">{{ n.subtitle }} · {{ n.timeLabel }}</p>
                    </div>
                    @if (n.statusText) {
                      <span class="notif-status" [class.is-error]="n.severity === 'error'">
                        {{ n.statusText }}
                      </span>
                    }
                    <button class="notif-close-btn" type="button" aria-label="Cerrar notificación"
                            (click)="dismissNotification(n); $event.stopPropagation()">
                      <svg [lucideIcon]="getDeviceIcon('x')" [size]="14"></svg>
                    </button>
                  </article>
                }
                @if (recentActivities().length === 0) {
                  <div class="notif-empty"><p>No hay actividad reciente</p></div>
                }
              </div>
            }
          </section>
        }

        <!-- Pill de fecha / panel de clima -->
        <div class="date-container">
          <button class="date-pill-btn" (click)="toggleDatePanel(); $event.stopPropagation()">
            <svg [lucideIcon]="getDeviceIcon('sun')" [size]="18" style="color:#f4b400"></svg>
            <div class="date-text-wrapper">
              <strong>{{ dayLabel }}</strong>
              <span>{{ timeLabel }}</span>
            </div>
          </button>

          @if (datePanelOpen()) {
            <div class="weather-date-panel" (mouseleave)="closeDatePanel()">

              <div class="weather-orbit">
                <div [class]="'weather-circle ' + (weatherService.info()?.cssClass || 'sunny')">
                  @if (weatherService.loading()) {
                    <svg [lucideIcon]="getDeviceIcon('sun')" class="spin" [size]="76"></svg>
                  } @else if (weatherService.info(); as w) {
                    <svg [lucideIcon]="w.icon" [size]="76"></svg>
                  } @else {
                    <svg [lucideIcon]="getDeviceIcon('sun')" [size]="76"></svg>
                  }
                </div>
                <div class="weather-time-box">
                  <span class="weather-clock-main">{{ clockTime() }}</span>
                  <span class="weather-clock-period">{{ clockMeridiem() }}</span>
                </div>
              </div>

              <div class="weather-info-box">
                <div class="weather-calendar-badge">
                  <svg [lucideIcon]="getDeviceIcon('calendar-days')" [size]="28"></svg>
                </div>
                <strong>{{ dayLabel }}</strong>

                @if (weatherService.info(); as w) {
                  <span>{{ w.summary }} · {{ w.temperature }}</span>
                  <small>{{ w.place }} · {{ w.updatedAt }}</small>
                } @else if (weatherService.loading()) {
                  <span>Cargando clima...</span>
                  <small>Consultando ubicación</small>
                } @else {
                  <span>Día y clima</span>
                  <small>{{ weatherService.error() || 'Toca para actualizar' }}</small>
                }
              </div>

              <div class="weather-footer-row">
                <span class="weather-footer-place">
                  <svg [lucideIcon]="getDeviceIcon('map-pin')" [size]="16"></svg>
                  {{ weatherService.info()?.place ?? 'Ubicación actual' }}
                </span>
                <span class="weather-footer-time">
                  {{ weatherService.info()?.updatedAt ?? timeLabel }}
                </span>
                <svg [lucideIcon]="getDeviceIcon('chevron-right')" [size]="18" class="weather-footer-arrow"></svg>
              </div>

            </div>
          }
        </div>

      </div>
    </section>
  </header>

  <!-- ── Contenido principal ───────────────────────────────────────────── -->
  <main class="dashboard-main" (click)="$event.stopPropagation()">
    <router-outlet />
  </main>

  <!-- ── Modal: confirmar cierre de sesión ────────────────────────────── -->
  @if (authService.showLogoutModal()) {
    <div class="logout-modal-overlay" (click)="authService.cancelLogout()">
      <div class="logout-modal-card" (click)="$event.stopPropagation()">
        <div class="logout-modal-icon-container">
          <svg [lucideIcon]="getDeviceIcon('log-out')" class="logout-modal-icon"></svg>
        </div>
        <h2 class="logout-modal-title">¿Estás seguro de que deseas salir?</h2>
        <p class="logout-modal-desc">Tu sesión se cerrará de forma segura en este dispositivo.</p>
        <div class="logout-modal-buttons">
          <button class="logout-btn-cancel"  (click)="authService.cancelLogout()">Cancelar</button>
          <button class="logout-btn-confirm" (click)="authService.logout()">Sí, salir</button>
        </div>
      </div>
    </div>
  }

  <!-- ── Modal: detalle de gesto ──────────────────────────────────────── -->
  @if (gestosService.selectedGesto(); as gesto) {
    <div class="modal-backdrop" (click)="gestosService.cerrarDetalle()">
      <div class="modal-detail-container" (click)="$event.stopPropagation()">

        <header class="modal-header">
          <div class="header-titles">
            <h2 class="modal-main-title">Detalle del Gesto</h2>
            <p class="modal-main-subtitle">Información técnica, recomendaciones y material multimedia.</p>
          </div>
          <button class="btn-close-modal" aria-label="Cerrar" (click)="gestosService.cerrarDetalle()">✕</button>
        </header>

        <div class="modal-body">
          <div class="detail-layout">

            <div class="detail-main">

              <section class="card hero-info-card">
                <div class="hero-header">
                  <div class="hero-icon-box">
                    <svg [lucideIcon]="getGestureIcon(gesto.icono)" [size]="44" class="gesto-hero-img"></svg>
                  </div>
                  <div class="hero-titles">
                    <h2 class="hero-name">{{ gesto.nombre_gesto }}</h2>
                    <span class="status-indicator">
                      <span class="dot"></span>
                      {{ gesto.estado || (gesto.activo ? 'Activo' : 'Pausado') }}
                    </span>
                    <p class="hero-desc">{{ gesto.descripcion }}</p>
                  </div>
                </div>
              </section>

              <section class="section-container">
                <h3 class="section-title">Recomendaciones</h3>
                <div class="rec-grid">
                  @for (rec of gesto.recomendaciones; track $index) {
                    <div class="rec-pill">
                      <div class="rec-check-circle">
                        <svg [lucideIcon]="getDeviceIcon('check')" [size]="12" class="check-icon"></svg>
                      </div>
                      <p>{{ rec }}</p>
                    </div>
                  }
                </div>
              </section>

              @if (gesto.multimedia) {
                <section class="section-container media-container">
                  <h3 class="media-title">Fotos y videos</h3>
                  <p class="media-subtitle">Material de referencia para este gesto.</p>
                  <div class="media-row">
                    @for (media of consolidatedMedia(); track media.sk_media_id) {
                      @if (media.tipo_media === 1) {
                        <!-- Foto Box -->
                        <div class="media-thumb foto-box" (click)="openMediaViewer($index)">
                          <div class="thumb-content">
                            @if (media.url_archivo && media.url_archivo.startsWith('http')) {
                              <img [src]="media.url_archivo" alt="Referencia Gesto" style="width:100%;height:100%;object-fit:cover">
                            } @else {
                              <svg [lucideIcon]="getGestureIcon(gesto.icono)" [size]="44" class="gesto-thumb-fallback-img"></svg>
                            }
                          </div>
                          <span class="thumb-icon-overlay">
                            <svg [lucideIcon]="getDeviceIcon('camera')" [size]="14"></svg>
                          </span>
                        </div>
                      } @else {
                        <!-- Video Box -->
                        <div class="media-thumb video-box" (click)="openMediaViewer($index)">
                          <div class="video-preview-mask">
                            <svg [lucideIcon]="getDeviceIcon('play')" [size]="32" color="white"></svg>
                          </div>
                        </div>
                      }
                    }
                  </div>
                </section>
              }

            </div>

            <aside class="detail-sidebar">
              <div class="sidebar-info-card">
                <h3 class="sidebar-card-title">Información rápida</h3>
                <div class="info-rows">
                  <div class="info-row">
                    <div class="info-row-left">
                      <svg [lucideIcon]="getDeviceIcon('check')" class="info-icon"></svg>
                      <span>Estado</span>
                    </div>
                    <span class="info-row-val status-text-green">
                      {{ gesto.estado || (gesto.activo ? 'Activo' : 'Pausado') }}
                    </span>
                  </div>
                  <div class="info-row">
                    <div class="info-row-left">
                      <svg [lucideIcon]="getDeviceIcon('clock')" class="info-icon"></svg>
                      <span>Duración</span>
                    </div>
                    <span class="info-row-val">{{ gesto.duracion_segundos || 1 }} seg.</span>
                  </div>
                  <div class="info-row">
                    <div class="info-row-left">
                      <svg [lucideIcon]="getDeviceIcon('sun')" class="info-icon"></svg>
                      <span>Iluminación</span>
                    </div>
                    <span class="info-row-val">{{ gesto.iluminacion_requerida || 'Alta' }}</span>
                  </div>
                  <div class="info-row">
                    <div class="info-row-left">
                      <svg [lucideIcon]="getDeviceIcon('layout-dashboard')" class="info-icon"></svg>
                      <span>Distancia recomendada</span>
                    </div>
                    <span class="info-row-val">
                      @if (gesto.detalle?.distancia_recomendada) {
                        {{ gesto.detalle?.distancia_recomendada }}
                      } @else {
                        {{ gesto.distancia_minima_m || 0.5 }} – {{ gesto.distancia_maxima_m || 1.5 }} m
                      }
                    </span>
                  </div>
                  <div class="info-row">
                    <div class="info-row-left">
                      <svg [lucideIcon]="getDeviceIcon('smartphone')" class="info-icon"></svg>
                      <span>Dispositivo</span>
                    </div>
                    <span class="info-row-val">{{ obtenerNombreDispositivo(gesto.sk_aparato_id) }}</span>
                  </div>
                </div>
              </div>
            </aside>

          </div>
        </div>

        <footer class="modal-footer-actions">
          <button class="btn-action-outline-gray">
            <svg [lucideIcon]="getDeviceIcon('download')" [size]="18"></svg>
            Descargar guía
          </button>
          <button class="btn-action-solid-teal">
            <svg [lucideIcon]="getDeviceIcon('smartphone')" [size]="18"></svg>
            Probar gesto
          </button>
        </footer>

      </div>
    </div>
  }

  <!-- ── Modal: detalle de dispositivo ────────────────────────────────── -->
  @if (dispositivosService.selectedDevice(); as device) {
    <div class="modal-backdrop" (click)="dispositivosService.cerrarDetalle()">
      <div class="modal-detail-container" (click)="$event.stopPropagation()">

        <header class="modal-header">
          <div class="header-titles">
            <h2 class="modal-main-title">Detalle del Dispositivo</h2>
            <p class="modal-main-subtitle">Información técnica y configuración actual.</p>
          </div>
          <button class="btn-close-modal" aria-label="Cerrar" (click)="dispositivosService.cerrarDetalle()">✕</button>
        </header>

        <div class="modal-body">
          <div class="detail-layout">

            <div class="detail-main">

              <section class="card hero-info-card" style="position: relative;">
                <div class="hero-header">
                  <div class="hero-icon-box">
                    <svg [lucideIcon]="getDeviceIcon(device.tipo_aparato || device.icono)" [size]="44"></svg>
                  </div>
                  <div class="hero-titles">
                    <h2 class="hero-name">{{ device.nombre_aparato }}</h2>
                    <span class="status-indicator">
                      <span class="dot" [class.offline]="!dispositivosService.connectedDevices().includes(device.mac_bluetooth || '')"></span>
                      {{ dispositivosService.connectedDevices().includes(device.mac_bluetooth || '') ? 'En línea' : 'Desconectado' }}
                    </span>
                    <p class="hero-desc">{{ device.tipo_aparato }} – Control inteligente vía Bluetooth</p>
                  </div>

                  @if (!isMultisocket(device.tipo_aparato)) {
                    <div class="action-btn-status"
                         [class.on]="device.accion_nombre === 'Encendido'"
                         (click)="dispositivosService.toggleDevice(device); $event.stopPropagation()"
                         style="position: absolute; right: 24px; top: 24px; z-index: 10;">
                      <svg [lucideIcon]="getDeviceIcon('power')" [size]="14"></svg>
                      <span>{{ device.accion_nombre }}</span>
                    </div>
                  }

                  @if (isMultisocket(device.tipo_aparato)) {
                    <div class="modal-multisocket-panel">
                      <p class="modal-ms-label">
                        Contactos • {{ getActiveContactCountDetalle() }}/4 activos
                      </p>
                    </div>
                  }
                </div>
              </section>

              <section class="section-container">
                <h3 class="section-title">Información del Sistema</h3>
                <div class="tech-grid">
                  <div class="tech-item">
                    <p class="tech-label">FECHA DE ALTA</p>
                    <p class="tech-value">{{ device.fecha_sincronizacion || '2026-06-17' }}</p>
                  </div>
                </div>
              </section>

            </div>

            <aside class="detail-sidebar">
              <div class="sidebar-info-card">
                <h3 class="sidebar-card-title">Estado Bluetooth</h3>
                <div class="info-rows">
                  <div class="info-row">
                    <div class="info-row-left">
                      <svg [lucideIcon]="getDeviceIcon('bluetooth')" class="info-icon"></svg>
                      <span>Nombre</span>
                    </div>
                    <span class="info-row-val">{{ device.nombre_bluetooth || 'Sin nombre' }}</span>
                  </div>
                  <div class="info-row">
                    <div class="info-row-left">
                      <svg [lucideIcon]="getDeviceIcon('hash')" class="info-icon"></svg>
                      <span>MAC</span>
                    </div>
                    <span class="info-row-val">{{ device.mac_bluetooth || '00:00:00:00:00:00' }}</span>
                  </div>
                  <div class="info-row">
                    <div class="info-row-left">
                      <svg [lucideIcon]="getDeviceIcon('zap')" class="info-icon"></svg>
                      <span>Acción</span>
                    </div>
                    <span class="info-row-val status-text-green">{{ device.accion_nombre }}</span>
                  </div>
                </div>
              </div>
            </aside>

          </div>
        </div>

        <footer class="modal-footer-actions">
          <button class="btn-action-outline-gray" (click)="dispositivosService.cerrarDetalle()">
            Cerrar
          </button>
          <button class="btn-action-solid-teal">
            <svg [lucideIcon]="getDeviceIcon('bolt')" [size]="18"></svg>
            Ejecutar prueba
          </button>
        </footer>

      </div>
    </div>
  }

  <!-- ── Overlay: Visor Multimedia Avanzado ────────────────────────────── -->
  @if (mediaViewerOpen() && currentMedia()) {
    @let media = currentMedia();
    <div class="media-viewer-overlay" (click)="closeMediaViewer()">
      <div class="media-viewer-content" (click)="$event.stopPropagation()">

        <!-- Cabecera del Visor -->
        <header class="viewer-header">
          <div class="viewer-gesto-info">
            <div class="viewer-icon-box">
              <svg [lucideIcon]="getGestureIcon(gestosService.selectedGesto()?.icono)" [size]="24"></svg>
            </div>
            <div>
              <h4 class="viewer-title">{{ gestosService.selectedGesto()?.nombre_gesto }}</h4>
              <p class="viewer-status">● {{ gestosService.selectedGesto()?.estado || 'Pausado' }}</p>
            </div>
          </div>
          <button class="viewer-close-btn" (click)="closeMediaViewer()">
            <svg [lucideIcon]="getDeviceIcon('x')" [size]="20"></svg>
          </button>
        </header>

        <!-- Área Principal de Media -->
        <div class="viewer-main-area">
          <button class="nav-arrow prev" (click)="prevMedia()">
            <svg [lucideIcon]="getDeviceIcon('chevron-left')" [size]="32"></svg>
            <span>Anterior</span>
          </button>

          <div class="main-media-container">
            @if (media?.tipo_media === 1) {
              <img [src]="media?.url_archivo" class="main-media-img" alt="Referencia">
            } @else {
              <video class="main-media-video"
                     [src]="media?.url_archivo"
                     [autoplay]="isPlaying()"
                     [muted]="isMuted()"
                     (loadedmetadata)="onVideoMetadata($event)"
                     (timeupdate)="onVideoTimeUpdate($event)"
                     #videoPlayer>
              </video>
            }
          </div>

          <button class="nav-arrow next" (click)="nextMedia()">
            <svg [lucideIcon]="getDeviceIcon('chevron-right')" [size]="32"></svg>
            <span>Siguiente</span>
          </button>
        </div>

        <!-- Controles Inferiores (Solo para Video) -->
        <footer class="viewer-footer">
          @if (media?.tipo_media === 2) {
            <div class="video-controls-wrapper">
              <div class="seek-bar-container">
                <span class="time-label">{{ formatVideoTime(currentTime()) }}</span>
                <input type="range" class="viewer-seek-bar"
                       [value]="(currentTime() / duration()) * 100 || 0"
                       (input)="seekVideo($event)">
                <span class="time-label">{{ formatVideoTime(duration()) }}</span>
              </div>

              <div class="bottom-actions-row">
                <div class="left-actions">
                  <button class="action-btn" (click)="togglePlay()">
                    @if (isPlaying()) {
                      <svg [lucideIcon]="getDeviceIcon('pause')" [size]="20"></svg>
                    } @else {
                      <svg [lucideIcon]="getDeviceIcon('play')" [size]="20"></svg>
                    }
                  </button>
                  <button class="action-btn" (click)="toggleMute()">
                    @if (isMuted()) {
                      <svg [lucideIcon]="getDeviceIcon('volume-x')" [size]="20"></svg>
                    } @else {
                      <svg [lucideIcon]="getDeviceIcon('volume-2')" [size]="20"></svg>
                    }
                  </button>
                  <button class="action-btn" (click)="skip(-10)">
                    <svg [lucideIcon]="getDeviceIcon('rotate-ccw')" [size]="20"></svg>
                  </button>
                  <button class="action-btn" (click)="skip(10)">
                    <svg [lucideIcon]="getDeviceIcon('rotate-cw')" [size]="20"></svg>
                  </button>
                </div>

                <div class="right-actions">
                  <button class="action-btn">
                    <svg [lucideIcon]="getDeviceIcon('settings')" [size]="20"></svg>
                  </button>
                  <button class="action-btn">
                    <svg [lucideIcon]="getDeviceIcon('maximize')" [size]="20"></svg>
                  </button>
                </div>
              </div>
            </div>
          }
        </footer>

      </div>
    </div>
  }

</div>
