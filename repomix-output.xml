}

.weather-calendar-badge {
  position: absolute;
  left: 0.95rem;
  top: 50%;
  transform: translateY(-50%);
  width: 48px;
  height: 48px;
  border-radius: 16px;
  background:
    linear-gradient(145deg, rgba(236, 253, 250, 0.96), rgba(224, 242, 241, 0.88));
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85);
  display: grid;
  place-items: center;
