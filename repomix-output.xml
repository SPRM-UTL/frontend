}

.weather-info-box strong {
  font-size: 1.18rem;
  font-weight: 800;
  line-height: 1.15;
  color: #111827;
}

.weather-info-box span {
  margin-top: 0.32rem;
  font-size: 0.9rem;
  color: #5b667a;
  font-weight: 500;
}

.weather-info-box small {
  display: none;
}

.weather-footer-row {
  width: calc(100% + 2.7rem);
  margin-top: auto;
  padding: 1rem 1.35rem;
  border-top: 1px solid rgba(226, 232, 240, 0.9);
  display: grid;
  grid-template-columns: 1fr auto auto;
  align-items: center;
