:host {
  display: block;
}

@keyframes slideUpFromBottom {
  from {
    opacity: 0;
    transform: translateY(100vh);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.gestos-container {
  animation: slideUpFromBottom 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  padding-bottom: 2rem;
}

/* ══════════════════════════════
   ICON HELPER
══════════════════════════════ */
.icon-mask {
  display: inline-block;
  flex-shrink: 0;
}

/* ══════════════════════════════
   PAGE HEADER
══════════════════════════════ */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 2rem;
}

.page-title {
  font-size: 1.6rem;
  font-weight: 800;
  color: var(--cafe-dark);
}

.page-subtitle {
  font-size: 0.9rem;
  color: #64748b;
  margin-top: 0.2rem;
}

/* ══════════════════════════════
   SEARCH & FILTER
══════════════════════════════ */
.search-filter-row {
  display: flex;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.search-wrapper { position: relative; flex: 1; }
.search-icon {
  position: absolute;
  left: 1rem;
  top: 50%;
  transform: translateY(-50%);
  width: 18px;
  height: 18px;
  color: #94a3b8;
}
.search-input { width: 100%; padding: 0.85rem 1rem 0.85rem 3rem; border: 1px solid #e2e8f0; border-radius: 12px; background: #f8fafc; font-size: 0.95rem; outline: none; }
.search-input:focus { background: white; border-color: #2bbfaa; }

.filter-wrapper { min-width: 220px; }

.custom-dropdown {
  position: relative;
  width: 100%;
}

.dropdown-trigger {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.85rem 1.25rem;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.2s;
  outline: none;
}

.dropdown-trigger:hover, .dropdown-trigger:focus {
