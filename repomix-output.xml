}

.weather-circle.sunny { color: #F4B400; }
.weather-circle.cloudy { color: #94a3b8; }
.weather-circle.rainy { color: #3b82f6; }
.weather-circle.stormy { color: #6366f1; }
.weather-circle.night { color: #B0C4DE; }

.weather-time-box {
  position: relative;
  transform: none;
  min-height: auto;
  border: none;
  background: transparent;
