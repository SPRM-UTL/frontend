<file path="src/app/shared/pipes/count-devices.pipe.ts">
import { Pipe, PipeTransform } from '@angular/core';

@Pipe({
  name: 'countDevices',
  standalone: true
})
export class CountDevicesPipe implements PipeTransform {
  transform(habitaciones: any[] | undefined | null): number {
    if (!habitaciones || !Array.isArray(habitaciones)) return 0;
    return habitaciones.reduce((acc, h) => acc + (h.dispositivos?.length || 0), 0);
  }
}
</file>

<file path="src/app/shared/pipes/find-by-id.pipe.ts">
import { Pipe, PipeTransform } from '@angular/core';

@Pipe({
  name: 'findById',
  standalone: true
})
export class FindByIdPipe implements PipeTransform {
  transform(items: any[] | null, id: any, key: string = 'id'): any {
    if (!items || id === undefined || id === null) return null;
    return items.find(item => item[key] === id);
  }
}
</file>

