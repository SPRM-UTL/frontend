}
.gesto-card:hover { transform: translateY(-4px); box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08); }

.gesto-icon-circle { width: 44px; height: 44px; border: 1px solid #e6f7f5; color: #2bbfaa; border-radius: 50%; display: grid; place-items: center; }

.gesto-icon-img {
  width: 24px;
  height: 24px;
  color: var(--cafe-primary);
}

.gesto-hero-img {
  width: 44px;
  height: 44px;
  color: var(--cafe-primary);
}

.gesto-thumb-fallback-img {
  width: 44px;
  height: 44px;
  color: var(--cafe-primary);
}

.gesto-nombre { font-size: 1.05rem; font-weight: 800; color: var(--cafe-dark); margin: 0.25rem 0; }
.info-group { display: flex; flex-direction: column; gap: 0.15rem; }
.info-label { font-size: 0.65rem; font-weight: 800; color: #94a3b8; letter-spacing: 0.08em; }
.info-value { font-size: 0.88rem; font-weight: 600; color: #0d9488; }
.gesto-card-footer { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 1rem; border-top: 1px solid #f9fafb; }
.footer-actions { display: flex; gap: 0.85rem; }
.footer-icon { color: var(--cafe-primary); }

.empty-state svg {
  color: var(--cafe-primary);
}

/* Animations */
.animate-fade-in { animation: fadeIn 0.3s ease-out; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; } }

@media (max-width: 900px) {
  .detail-layout { grid-template-columns: 1fr; }
  .modal-backdrop { padding: 1rem; }
  .modal-detail-container { max-height: 95vh; overflow-y: auto; }
}
