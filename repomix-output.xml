<file path="src/app/dispositivos/dispositivos.css">
/* dispositivos.css — Estilos modernos tipo tabla */

:host {
  display: block;
}

@keyframes slideUpFromBottom {
  from {
    opacity: 0;
    transform: translateY(100vh);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.dispositivos-container {
  animation: slideUpFromBottom 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* ══════════════════════════════
   PAGE HEADER
══════════════════════════════ */
.empty-state {
  padding: 5rem !important;
  color: white;
  text-align: center;
}

.empty-state svg {
  margin: 0 auto 1rem auto;
  display: block;
}

.empty-state p {
  margin: 0;
  font-size: 1rem;
  text-align: center;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 2rem;
}

.page-title {
  font-size: 1.6rem;
  font-weight: 800;
  color: var(--cafe-dark);
  font-family: var(--font-title);
}

.page-subtitle {
  font-size: 0.9rem;
  color: #64748b;
  margin-top: 0.2rem;
}

/* ══════════════════════════════
   SEARCH & FILTER BAR
══════════════════════════════ */
.search-filter-row {
  display: flex;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.search-wrapper {
  position: relative;
  flex: 1;
}

.search-icon {
  position: absolute;
  left: 1rem;
  top: 50%;
  transform: translateY(-50%);
  width: 18px;
  height: 18px;
  color: #94a3b8;
}

.search-input {
  width: 100%;
  padding: 0.85rem 1rem 0.85rem 3rem;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  background: #f8fafc;
  font-size: 0.95rem;
  outline: none;
  transition: all 0.2s;
}

.search-input:focus {
  background: white;
  border-color: #2bbfaa;
  box-shadow: 0 0 0 4px rgba(43, 191, 170, 0.1);
}

.filter-wrapper {
  min-width: 220px;
}

.custom-dropdown {
  position: relative;
  width: 100%;
}

.dropdown-trigger {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.85rem 1.25rem;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.2s;
  outline: none;
}

.dropdown-trigger:hover, .dropdown-trigger:focus {
  background: white;
  border-color: #2bbfaa;
  box-shadow: 0 4px 12px rgba(43, 191, 170, 0.08);
}

.trigger-label {
